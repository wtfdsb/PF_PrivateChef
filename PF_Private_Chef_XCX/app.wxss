/* ============ 设计变量 ============
 * 新谷私厨调性：深墨黑 + 暖金点缀 + 米纸背景，衬线标题显高级
 * 所有页面共用，改这里就能整体换肤
 */
page {
  --ink: #0f0d0b;
  --ink-2: #1a1713;
  --ink-3: #221e18;
  --gold: #c9a15e;
  --gold-2: #e3c688;
  --paper: #f7f2e9;
  --paper-2: #fffdf9;
  --line: #e9e0d1;
  --line-ink: rgba(201, 161, 94, .22);
  --text: #1d1712;
  --text-2: #6b6153;
  --text-3: #9c9384;
  --danger: #c0392b;
  --ok: #2f8f5b;

  background: var(--paper);
  color: var(--text);
  font-size: 28rpx;
  line-height: 1.6;
  font-family: -apple-system, "PingFang SC", "Helvetica Neue", sans-serif;
}

/* ============ 布局 ============ */
.page {
  min-height: 100vh;
  padding-bottom: 180rpx; /* 给底部固定按钮留位 */
}
.wrap {
  padding: 0 32rpx;
}
.card {
  background: var(--paper-2);
  border-radius: 20rpx;
  border: 1rpx solid var(--line);
  overflow: hidden;
  transition: transform .25s ease, border-color .25s ease, box-shadow .25s ease;
}
.card:active { transform: scale(.985); }
.card-ink {
  background: var(--ink-2);
  border: 1rpx solid var(--line-ink);
  transition: transform .25s ease;
}
.gap {
  height: 24rpx;
}

/* ============ 文字 ============ */
.serif { font-family: "Songti SC", "Noto Serif SC", Georgia, "SimSun", serif; }
.h1 { font-size: 44rpx; font-weight: 600; letter-spacing: 2rpx; }
.h2 { font-size: 34rpx; font-weight: 600; }
.h3 { font-size: 30rpx; font-weight: 600; }
.muted { color: var(--text-2); }
.dim { color: var(--text-3); font-size: 24rpx; }
.gold { color: var(--gold); }
.ellipsis {
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

/* ============ 区块标题 ============ */
.section {
  margin-top: 44rpx;
}
.section-head {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
  margin-bottom: 22rpx;
}
.section-title {
  font-family: "Songti SC", "Noto Serif SC", Georgia, serif;
  font-size: 36rpx;
  font-weight: 600;
  letter-spacing: 3rpx;
  position: relative;
  padding-left: 22rpx;
}
.section-title::before {
  content: '';
  position: absolute;
  left: 0;
  top: 10rpx;
  bottom: 10rpx;
  width: 6rpx;
  border-radius: 3rpx;
  background: linear-gradient(180deg, var(--gold-2), var(--gold));
}
.section-more {
  color: var(--text-3);
  font-size: 24rpx;
}

/* ============ 按钮 ============ */
.btn {
  height: 92rpx;
  line-height: 92rpx;
  text-align: center;
  border-radius: 12rpx;
  font-size: 32rpx;
  font-weight: 600;
  letter-spacing: 3rpx;
  transition: transform .12s ease, opacity .12s ease;
}
.btn-primary {
  background: linear-gradient(135deg, var(--gold-2), var(--gold));
  color: #241d16;
}
.btn-ghost {
  border: 1rpx solid var(--gold);
  color: var(--gold);
  background: transparent;
}
.btn:active { transform: scale(.97); opacity: .88; }

/* 底部固定操作条 */
.footer-bar {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  padding: 20rpx 32rpx calc(20rpx + env(safe-area-inset-bottom));
  background: rgba(15, 13, 11, .96);
  border-top: 1rpx solid var(--line-ink);
}

/* ============ 标签 ============ */
.tag {
  display: inline-block;
  padding: 4rpx 16rpx;
  border-radius: 999rpx;
  font-size: 22rpx;
  background: rgba(201, 161, 94, .14);
  color: #9a7a35;
  margin-right: 12rpx;
}
.tag-dark {
  background: rgba(227, 198, 136, .12);
  border: 1rpx solid rgba(201, 161, 94, .4);
  color: var(--gold-2);
}

/* ============ 列表行 ============ */
.row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 28rpx 0;
  border-bottom: 1rpx solid var(--line);
}
.row:last-child { border-bottom: none; }

/* ============ 占位图（先用渐变，后续换成真实照片） ============ */
.ph {
  background:
    radial-gradient(140rpx 100rpx at 30% 30%, rgba(227, 198, 136, .4), transparent 70%),
    radial-gradient(180rpx 140rpx at 78% 72%, rgba(201, 161, 94, .3), transparent 72%),
    linear-gradient(135deg, #2a221a, #17120d);
  display: flex;
  align-items: center;
  justify-content: center;
  color: rgba(227, 198, 136, .85);
  font-size: 24rpx;
  letter-spacing: 6rpx;
  font-family: "Songti SC", "Noto Serif SC", Georgia, serif;
}

/* ============ 空态 ============ */
.empty {
  padding: 80rpx 0;
  text-align: center;
  color: var(--text-3);
  font-size: 26rpx;
}

/* ============ 动画 ============ */
@keyframes fadeUp {
  from { opacity: 0; transform: translateY(30rpx); }
  to { opacity: 1; transform: translateY(0); }
}
@keyframes fadeIn {
  from { opacity: 0; }
  to { opacity: 1; }
}
@keyframes popIn {
  from { opacity: 0; transform: scale(.88); }
  to { opacity: 1; transform: scale(1); }
}
@keyframes floatY {
  0%, 100% { transform: translateY(0); }
  50% { transform: translateY(-10rpx); }
}
@keyframes heroGlow {
  0% { background-position: 0% 50%; }
  50% { background-position: 100% 50%; }
  100% { background-position: 0% 50%; }
}
@keyframes ripple {
  0% { box-shadow: 0 0 0 0 rgba(201, 161, 94, .45); }
  100% { box-shadow: 0 0 0 24rpx rgba(201, 161, 94, 0); }
}

/* 入场动画（animation-fill-mode: both 防止闪烁） */
.anim-up { animation: fadeUp .55s cubic-bezier(.22, .61, .36, 1) both; }
.anim-in { animation: fadeIn .4s ease both; }
.anim-pop { animation: popIn .5s cubic-bezier(.34, 1.56, .64, 1) both; }
.d1 { animation-delay: .05s; }
.d2 { animation-delay: .1s; }
.d3 { animation-delay: .16s; }
.d4 { animation-delay: .22s; }
.d5 { animation-delay: .28s; }
.d6 { animation-delay: .34s; }
.d7 { animation-delay: .4s; }
.d8 { animation-delay: .46s; }

/* 悬浮客服按钮的呼吸效果 */
.kf-pulse { animation: ripple 2.2s ease-out infinite; }

/* 通用入场过渡 */
.svc-item, .slot-chip, .case-item, .pkg-item {
  transition: transform .25s ease, border-color .25s ease;
}
.svc-item:active, .slot-chip:active, .case-item:active {
  transform: scale(.97);
  border-color: var(--gold);
}
.need-tag { transition: transform .15s ease, background .2s ease; }
.need-tag:active { transform: scale(.94); }
.bk-btn { transition: transform .12s ease, opacity .12s ease; }
.bk-btn:active { transform: scale(.97); opacity: .85; }
