<view class="page">
  <view class="wrap">

    <view class="head">
      <view class="h1 serif">预约上门</view>
      <view class="muted head-sub">仅限平顶山市区，偏远区域加收上门里程费。填完提交即可，我会尽快联系您确认菜单与报价。</view>
    </view>

    <!-- ========== 档期 ========== -->
    <view class="card form-card">
      <view class="form-title">选择档期</view>

      <view class="row">
        <text class="label">日期</text>
        <picker mode="selector" range="{{dateOptions}}" value="{{dateIndex}}" bindchange="onDateChange">
          <view class="picker-value">{{dateOptions[dateIndex] || '请选择'}} ›</view>
        </picker>
      </view>

      <view class="row">
        <text class="label">餐次</text>
        <picker mode="selector" range="{{mealOptions}}" value="{{mealIndex}}" bindchange="onMealChange">
          <view class="picker-value">{{mealOptions[mealIndex]}} ›</view>
        </picker>
      </view>

      <view class="row">
        <text class="label">就餐人数</text>
        <input
          class="input"
          type="number"
          placeholder="如:8人"
          placeholder-class="ph-text"
          value="{{form.people}}"
          data-key="people"
          bindinput="onInput"
        />
      </view>

      <view class="row">
        <text class="label">预算</text>
        <picker mode="selector" range="{{budgetOptions}}" value="{{budgetIndex}}" bindchange="onBudgetChange">
          <view class="picker-value">¥{{budgetOptions[budgetIndex]}} ›</view>
        </picker>
      </view>
    </view>

    <!-- ========== 口味与需求 ========== -->
    <view class="card form-card">
      <view class="form-title">口味与需求</view>

      <view class="field-block">
        <view class="field-label">口味与忌口</view>
        <textarea
          class="textarea"
          placeholder="如:一家不吃辣、孩子老人多、海鲜过敏..."
          placeholder-class="ph-text"
          value="{{form.taste}}"
          data-key="taste"
          maxlength="100"
          bindinput="onInput"
        />
      </view>

      <view class="field-block">
        <view class="field-label">特殊需求</view>
        <view class="need-tags">
          <text
            wx:for="{{needTags}}"
            wx:key="*this"
            class="need-tag"
            data-tag="{{item}}"
            bindtap="onNeedTag"
          >{{item}}</text>
        </view>
        <textarea
          class="textarea"
          placeholder="如:需要摆盘仪式、酒水代办、餐后收拾、代采购食材..."
          placeholder-class="ph-text"
          value="{{form.needs}}"
          data-key="needs"
          maxlength="100"
          bindinput="onInput"
        />
      </view>

      <view class="field-block">
        <view class="field-label">其他备注</view>
        <textarea
          class="textarea"
          placeholder="场地情况（灶台、燃气、锅具）、想吃某道菜..."
          placeholder-class="ph-text"
          value="{{form.remark}}"
          data-key="remark"
          maxlength="150"
          bindinput="onInput"
        />
      </view>
    </view>

    <!-- ========== 联系方式 ========== -->
    <view class="card form-card">
      <view class="form-title">联系方式</view>

      <view class="row">
        <text class="label">怎么称呼</text>
        <input
          class="input"
          placeholder="例如：张先生"
          placeholder-class="ph-text"
          value="{{form.name}}"
          data-key="name"
          bindinput="onInput"
        />
      </view>

      <view class="row">
        <text class="label">手机号</text>
        <input
          class="input"
          type="number"
          maxlength="11"
          placeholder="用于确认菜单"
          placeholder-class="ph-text"
          value="{{form.phone}}"
          data-key="phone"
          bindinput="onInput"
        />
      </view>

      <view class="row row-top">
        <text class="label">场地地址</text>
        <textarea
          class="textarea"
          placeholder="做菜的地址（家里 / 公司 / 场地），尽量写详细"
          placeholder-class="ph-text"
          value="{{form.address}}"
          data-key="address"
          maxlength="120"
          bindinput="onInput"
        />
      </view>

      <view class="row">
        <text class="label">介绍人</text>
        <input
          class="input"
          placeholder="谁推荐您来的（可不填）"
          placeholder-class="ph-text"
          value="{{form.source}}"
          data-key="source"
          bindinput="onInput"
        />
      </view>
    </view>

    <!-- ========== 定金规则 ========== -->
    <view class="notice">
      <view class="notice-title serif">提交前请知悉</view>
      <view>· 预约需支付 <text class="em">20% 定金</text>锁定档期，提前 2 天可免费改期；余款餐后结算</view>
      <view>· 定金线下收取（微信/支付宝/现金），我会电话与您确认菜单与报价</view>
      <view>· 食材<text class="em">实报实销</text>（提供采购小票），<text class="em">确认后才算定档</text></view>
      <view>· 提交后请留意来电，预约信息会同步到「我的预约」</view>
    </view>

    <view class="gap"></view>
    <view class="gap"></view>
  </view>

  <view class="footer-bar">
    <view class="btn btn-primary {{submitting ? 'btn-disabled' : ''}}" bindtap="onSubmit">
      {{submitting ? '提交中…' : '提交预约'}}
    </view>
  </view>
</view>
