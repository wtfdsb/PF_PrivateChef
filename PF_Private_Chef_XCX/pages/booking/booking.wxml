<view class="page">
  <view class="wrap">

    <view class="head">
      <view class="h1">预约上门做饭</view>
      <view class="muted head-sub">填完提交即可，我会在 2 小时内联系您确认菜单与报价</view>
    </view>

    <!-- ========== 档期 ========== -->
    <view class="card form-card">
      <view class="form-title">选择档期</view>

      <view class="row">
        <text class="label">日期</text>
        <picker mode="selector" range="{{dateOptions}}" value="{{dateIndex}}" bindchange="onDateChange">
          <view class="picker-value">{{dateOptions[dateIndex] || '请选择'}} ›</view>
        </picker>
      </view>

      <view class="row">
        <text class="label">餐次</text>
        <picker mode="selector" range="{{mealOptions}}" value="{{mealIndex}}" bindchange="onMealChange">
          <view class="picker-value">{{mealOptions[mealIndex]}} ›</view>
        </picker>
      </view>

      <view class="row">
        <text class="label">人数</text>
        <input
          class="input"
          type="number"
          placeholder="预计用餐人数"
          placeholder-class="ph-text"
          value="{{form.people}}"
          data-key="people"
          bindinput="onInput"
        />
      </view>

      <view class="row">
        <text class="label">预算</text>
        <picker mode="selector" range="{{budgetOptions}}" value="{{budgetIndex}}" bindchange="onBudgetChange">
          <view class="picker-value">¥{{budgetOptions[budgetIndex]}} ›</view>
        </picker>
      </view>
    </view>

    <!-- ========== 联系方式 ========== -->
    <view class="card form-card">
      <view class="form-title">联系方式</view>

      <view class="row">
        <text class="label">怎么称呼</text>
        <input
          class="input"
          placeholder="例如：张先生"
          placeholder-class="ph-text"
          value="{{form.name}}"
          data-key="name"
          bindinput="onInput"
        />
      </view>

      <view class="row">
        <text class="label">手机号</text>
        <input
          class="input"
          type="number"
          maxlength="11"
          placeholder="用于确认菜单"
          placeholder-class="ph-text"
          value="{{form.phone}}"
          data-key="phone"
          bindinput="onInput"
        />
      </view>

      <view class="row row-top">
        <text class="label">场地地址</text>
        <textarea
          class="textarea"
          placeholder="做菜的地址（家里 / 公司 / 场地），尽量写详细"
          placeholder-class="ph-text"
          value="{{form.address}}"
          data-key="address"
          maxlength="120"
          bindinput="onInput"
        />
      </view>
    </view>

    <!-- ========== 其他要求 ========== -->
    <view class="card form-card">
      <view class="form-title">其他要求</view>
      <textarea
        class="textarea textarea-block"
        placeholder="忌口 / 过敏 / 想吃某道菜 / 场地情况（灶台、燃气、锅具）…"
        placeholder-class="ph-text"
        value="{{form.remark}}"
        data-key="remark"
        maxlength="200"
        bindinput="onInput"
      />
      <view class="row" style="margin-top:8rpx;">
        <text class="label">介绍人</text>
        <input
          class="input"
          placeholder="谁推荐您来的（可不填）"
          placeholder-class="ph-text"
          value="{{form.source}}"
          data-key="source"
          bindinput="onInput"
        />
      </view>
    </view>

    <view class="notice">
      <view class="notice-title">提交前请知悉</view>
      <view>· 食材<text class="em">实报实销</text>（提供采购小票），服务费按确认的菜单单独报价</view>
      <view>· 提交后我会电话/微信与您确认菜单与报价，<text class="em">确认后才算定档</text></view>
      <view>· 定档需支付定金；如需取消请提前 48 小时，定金可退或改期</view>
    </view>

    <view class="gap"></view>
    <view class="gap"></view>
  </view>

  <view class="footer-bar">
    <view class="btn btn-primary {{submitting ? 'btn-disabled' : ''}}" bindtap="onSubmit">
      {{submitting ? '提交中…' : '提交预约'}}
    </view>
  </view>
</view>
