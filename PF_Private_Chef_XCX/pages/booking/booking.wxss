.head { padding: 44rpx 0 32rpx; }
.head-sub { margin-top: 12rpx; line-height: 1.7; }

.form-card { padding: 8rpx 28rpx; margin-bottom: 24rpx; }
.form-title {
  font-family: "Songti SC", "Noto Serif SC", Georgia, serif;
  font-size: 27rpx;
  color: #9a7a35;
  letter-spacing: 3rpx;
  padding: 24rpx 0 4rpx;
}

.label {
  width: 190rpx;
  flex-shrink: 0;
  color: var(--text-2);
  font-size: 27rpx;
}
.input {
  flex: 1;
  text-align: right;
  font-size: 28rpx;
  color: var(--text);
}
.picker-value {
  color: var(--text);
  font-size: 28rpx;
}
.ph-text { color: var(--text-3); font-size: 26rpx; }

.row-top { align-items: flex-start; }
.textarea {
  flex: 1;
  min-height: 100rpx;
  font-size: 28rpx;
  line-height: 1.7;
  text-align: left;
  width: 100%;
}

/* 口味与需求块 */
.field-block {
  padding: 22rpx 0 6rpx;
  border-bottom: 1rpx solid var(--line);
}
.field-block:last-child { border-bottom: none; }
.field-label {
  font-size: 25rpx;
  color: var(--text-2);
  margin-bottom: 12rpx;
}
.need-tags { margin-bottom: 12rpx; display: flex; flex-wrap: wrap; }
.need-tag {
  font-size: 23rpx;
  color: #9a7a35;
  background: rgba(201, 161, 94, .08);
  border: 1rpx solid rgba(201, 161, 94, .3);
  padding: 8rpx 22rpx;
  border-radius: 999rpx;
  margin: 0 14rpx 10rpx 0;
}
.need-tag:active { background: rgba(201, 161, 94, .2); }

.notice {
  background: rgba(201, 161, 94, .07);
  border: 1rpx solid rgba(201, 161, 94, .3);
  border-radius: 16rpx;
  padding: 26rpx 28rpx;
  font-size: 25rpx;
  line-height: 1.9;
  color: var(--text-2);
}
.notice-title {
  color: #9a7a35;
  font-weight: 600;
  letter-spacing: 2rpx;
  margin-bottom: 8rpx;
}

.btn-disabled { opacity: .6; }
.em { color: #9a7a35; font-weight: 600; }
