/* 头 */
.head { padding: 48rpx 0 8rpx; }
.h1 { font-size: 52rpx; letter-spacing: 3rpx; }
.subtitle {
  color: #9a7a35;
  font-size: 28rpx;
  margin-top: 10rpx;
  letter-spacing: 2rpx;
}
.intro {
  color: var(--text-2);
  font-size: 28rpx;
  line-height: 1.9;
  margin-top: 24rpx;
}

/* 卡片块 */
.block { padding: 28rpx; margin-top: 24rpx; }
.block-title {
  font-size: 25rpx;
  color: #9a7a35;
  letter-spacing: 2rpx;
  margin-bottom: 18rpx;
}

/* 场合 */
.scene-list { display: flex; flex-wrap: wrap; }
.scene-chip {
  font-size: 24rpx;
  color: var(--text-2);
  background: var(--paper);
  border: 1rpx solid var(--line);
  padding: 8rpx 24rpx;
  border-radius: 999rpx;
  margin: 0 14rpx 12rpx 0;
}

/* 菜单 */
.menu-line {
  display: flex;
  align-items: baseline;
  font-size: 28rpx;
  line-height: 2;
  color: var(--text);
}
.menu-dot { color: var(--gold); margin-right: 14rpx; }
.menu-note {
  margin-top: 14rpx;
  padding-top: 14rpx;
  border-top: 1rpx dashed var(--line);
  font-size: 23rpx;
  color: var(--text-3);
}

/* 价格卡（深色强调） */
.price-card {
  margin-top: 24rpx;
  background: var(--ink-2);
  border: 1rpx solid var(--line-ink);
  border-radius: 20rpx;
  padding: 30rpx 28rpx;
}
.price-label {
  color: rgba(240, 232, 216, .55);
  font-size: 23rpx;
  letter-spacing: 2rpx;
}
.price-value {
  color: var(--gold-2);
  font-size: 34rpx;
  font-weight: 600;
  margin-top: 8rpx;
  letter-spacing: 1rpx;
}

/* 准备事项 */
.prep-line {
  display: flex;
  align-items: flex-start;
  font-size: 27rpx;
  line-height: 1.9;
  color: var(--text-2);
}
.prep-mark {
  color: var(--ok);
  margin-right: 16rpx;
  flex-shrink: 0;
  font-weight: 600;
}

/* 小提示 */
.tips-card {
  margin-top: 24rpx;
  padding: 30rpx 28rpx;
  background: rgba(201, 161, 94, .07);
  border: 1rpx solid rgba(201, 161, 94, .3);
  border-radius: 20rpx;
  position: relative;
}
.tips-quote {
  position: absolute;
  top: 6rpx;
  left: 20rpx;
  font-size: 64rpx;
  color: rgba(201, 161, 94, .4);
  line-height: 1;
}
.tips-text {
  font-size: 27rpx;
  line-height: 1.9;
  color: #8a7136;
  padding-left: 40rpx;
  display: block;
}

/* 底部 */
.footer-2 { display: flex; gap: 20rpx; }
.footer-call { width: 260rpx; flex-shrink: 0; }
.footer-main { flex: 1; }
