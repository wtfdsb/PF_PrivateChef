/* 分类标签 */
.tabs {
  display: flex;
  background: var(--paper-2);
  border-bottom: 1rpx solid var(--line);
  position: sticky;
  top: 0;
  z-index: 10;
}
.tab {
  flex: 1;
  text-align: center;
  padding: 26rpx 0;
  font-size: 27rpx;
  color: var(--text-2);
  position: relative;
}
.tab.on {
  color: #9a7a35;
  font-weight: 600;
}
.tab.on::after {
  content: '';
  position: absolute;
  left: 50%;
  bottom: 8rpx;
  transform: translateX(-50%);
  width: 44rpx;
  height: 6rpx;
  border-radius: 3rpx;
  background: linear-gradient(90deg, var(--gold-2), var(--gold));
}

/* 押金提示 */
.dep-tip {
  margin: 24rpx 0 8rpx;
  padding: 20rpx 26rpx;
  border-radius: 16rpx;
  background: rgba(201, 161, 94, .08);
  border: 1rpx solid rgba(201, 161, 94, .35);
  font-size: 24rpx;
  color: var(--text-2);
  line-height: 1.7;
}
.dep-tip .em { color: #9a7a35; font-weight: 600; }

/* 菜品行 */
.item {
  display: flex;
  align-items: baseline;
  padding: 26rpx 4rpx;
  border-bottom: 1rpx dashed var(--line);
}
.item-name {
  font-size: 28rpx;
  color: var(--text);
  flex-shrink: 0;
  max-width: 68%;
}
.item-dots {
  flex: 1;
  border-bottom: 2rpx dotted rgba(156, 147, 132, .4);
  margin: 0 16rpx;
  transform: translateY(-8rpx);
}
.item-price {
  flex-shrink: 0;
  display: flex;
  align-items: baseline;
}
.price-num {
  color: #9a7a35;
  font-size: 32rpx;
  font-weight: 700;
}
.price-unit {
  color: var(--text-3);
  font-size: 22rpx;
  margin-left: 2rpx;
}

.menu-note {
  margin-top: 28rpx;
  text-align: center;
  color: var(--text-3);
  font-size: 23rpx;
}

.sk-wrap { padding-top: 24rpx; }

/* 底部 */
.footer-2 { display: flex; gap: 20rpx; }
.footer-call { width: 260rpx; flex-shrink: 0; }
.footer-main { flex: 1; }
