<view class="page">
  <!-- 分类标签 -->
  <view class="tabs">
    <view
      wx:for="{{tabs}}"
      wx:key="code"
      class="tab {{active === item.code ? 'on' : ''}}"
      data-code="{{item.code}}"
      bindtap="onTab"
    >{{item.label}}</view>
  </view>

  <view class="wrap">
    <!-- 押金分类说明 -->
    <view class="dep-tip anim-in" wx:if="{{active === 'deposit'}}">
      这些菜要<text class="em">提前预定并付押金</text>，打电话说一声，师傅当天现买现做。
    </view>

    <view wx:if="{{loading}}" class="sk-wrap">
      <view class="sk" style="height:80rpx;margin-bottom:16rpx;" wx:for="{{[1,2,3,4,5]}}" wx:key="*this"></view>
    </view>
    <view wx:elif="{{error}}" class="empty">
      <view>{{error}}</view>
      <view class="btn btn-ghost" style="margin:32rpx auto 0;width:300rpx;" bindtap="loadTab">重试</view>
    </view>

    <block wx:else>
      <view
        wx:for="{{items}}"
        wx:key="id"
        class="item anim-up"
        style="animation-delay: {{index * 0.03}}s"
      >
        <view class="item-name">{{item.name}}</view>
        <view class="item-dots"></view>
        <view class="item-price">
          <text class="price-num serif">{{item.price}}</text>
          <text class="price-unit">{{item.unit ? '元/' + item.unit : '元'}}</text>
        </view>
      </view>

      <view class="menu-note">菜单和价格会随季节调整，以电话沟通为准</view>
    </block>

    <view class="gap"></view>
    <view class="gap"></view>
  </view>

  <view class="footer-bar footer-2">
    <view class="btn btn-ghost footer-call" bindtap="callChef">打电话点菜</view>
    <view class="btn btn-primary footer-main" bindtap="goBooking">约一桌</view>
  </view>
</view>
