.head { padding: 44rpx 0 32rpx; }
.head-sub { margin-top: 12rpx; line-height: 1.7; white-space: pre-line; }

.pkg { padding: 30rpx 28rpx; margin-bottom: 24rpx; }
.pkg-head {
  display: flex;
  align-items: flex-end;
  justify-content: space-between;
}
.pkg-name { font-size: 36rpx; font-weight: 700; letter-spacing: 2rpx; }
.num { font-size: 48rpx; font-weight: 700; }
.num-sm { font-size: 30rpx; font-weight: 700; }
.pkg-tag {
  display: inline-block;
  margin-top: 12rpx;
  font-size: 23rpx;
  color: #9a7a35;
  background: rgba(200, 164, 92, .14);
  padding: 4rpx 16rpx;
  border-radius: 999rpx;
}
.pkg-dishes { margin-top: 22rpx; }
.dish-line {
  font-size: 27rpx;
  line-height: 1.95;
  color: var(--text-2);
  display: flex;
}
.dot { margin-right: 12rpx; color: var(--gold); }
.pkg-note {
  margin-top: 20rpx;
  padding-top: 18rpx;
  border-top: 1rpx dashed var(--line);
  font-size: 24rpx;
  color: var(--text-3);
  line-height: 1.7;
}

.rule {
  margin-top: 12rpx;
  padding: 26rpx 28rpx;
  background: rgba(200, 164, 92, .08);
  border: 1rpx solid rgba(200, 164, 92, .3);
  border-radius: 16rpx;
  font-size: 25rpx;
  line-height: 1.95;
  color: var(--text-2);
}
.rule-title { color: #9a7a35; font-weight: 600; margin-bottom: 8rpx; }
.em { color: #9a7a35; }
