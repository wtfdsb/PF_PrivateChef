.head { padding: 44rpx 0 32rpx; }
.head-sub { margin-top: 12rpx; line-height: 1.7; white-space: pre-line; }

.pkg { padding: 30rpx 28rpx 0; margin-bottom: 24rpx; position: relative; overflow: hidden; }
.pkg-badge {
  position: absolute;
  top: 0;
  right: 0;
  font-size: 20rpx;
  letter-spacing: 2rpx;
  color: #241d16;
  background: linear-gradient(135deg, var(--gold-2), var(--gold));
  padding: 6rpx 22rpx;
  border-radius: 0 20rpx 0 16rpx;
}
.pkg-head {
  display: flex;
  align-items: flex-end;
  justify-content: space-between;
  padding-top: 8rpx;
}
.pkg-name { font-size: 38rpx; font-weight: 700; letter-spacing: 2rpx; }
.pkg-price { text-align: right; flex-shrink: 0; margin-left: 20rpx; }
.pkg-rmb { font-size: 26rpx; color: var(--gold); }
.num { font-size: 60rpx; font-weight: 700; color: #9a7a35; }
.pkg-from { font-size: 24rpx; color: var(--text-3); }
.num-sm { font-size: 32rpx; font-weight: 700; color: #9a7a35; }

.pkg-note {
  margin-top: 14rpx;
  font-size: 25rpx;
  color: var(--text-2);
  line-height: 1.8;
}
.pkg-dishes { margin-top: 18rpx; display: flex; flex-wrap: wrap; }
.dish {
  font-size: 22rpx;
  color: #9a7a35;
  background: rgba(201, 161, 94, .1);
  border: 1rpx solid rgba(201, 161, 94, .3);
  padding: 6rpx 18rpx;
  border-radius: 999rpx;
  margin: 0 12rpx 12rpx 0;
}
.pkg-cta {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-top: 8rpx;
  padding: 22rpx 4rpx;
  border-top: 1rpx dashed var(--line);
  font-size: 26rpx;
  color: #9a7a35;
  font-weight: 600;
  letter-spacing: 2rpx;
}
.pkg-arrow { font-size: 30rpx; }

.rule {
  margin-top: 12rpx;
  padding: 28rpx;
  background: rgba(201, 161, 94, .07);
  border: 1rpx solid rgba(201, 161, 94, .3);
  border-radius: 16rpx;
  font-size: 25rpx;
  line-height: 2;
  color: var(--text-2);
}
.rule-title { color: #9a7a35; font-weight: 600; margin-bottom: 8rpx; letter-spacing: 2rpx; }
.em { color: #9a7a35; }
