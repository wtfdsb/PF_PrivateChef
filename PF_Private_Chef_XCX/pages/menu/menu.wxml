<view class="page">
  <view class="wrap">
    <view class="head">
      <view class="h1">参考档位</view>
      <view class="muted head-sub">{{chef.area}}\n按人均分档，可按需调整菜品</view>
    </view>

    <view wx:if="{{loading}}" class="empty">正在加载…</view>

    <view wx:for="{{packages}}" wx:key="id" class="card pkg">
      <view class="pkg-head">
        <view class="pkg-name">{{item.name}}</view>
        <view class="pkg-price">
          <block wx:if="{{item.perPerson > 0}}">
            <text class="gold num">{{item.perPerson}}</text>
            <text class="dim"> 元/人起</text>
          </block>
          <block wx:else>
            <text class="gold num-sm">按需定制</text>
          </block>
        </view>
      </view>

      <view class="pkg-tag">{{item.tag}}</view>

      <view class="pkg-dishes">
        <view wx:for="{{item.dishes}}" wx:for-item="d" wx:key="*this" class="dish-line">
          <text class="dot">·</text>
          <text>{{d}}</text>
        </view>
      </view>

      <view class="pkg-note">{{item.note}}</view>
    </view>

    <view class="rule">
      <view class="rule-title">报价与结算</view>
      <view>· 上表为<text class="em">参考档位</text>，最终金额以您确认的菜单为准</view>
      <view>· <text class="em">服务费</text>：按桌/按人计价</view>
      <view>· <text class="em">食材费</text>：实报实销，提供采购小票；也可由您自行采购</view>
      <view>· 高档食材（参鲍翅肚、深海鱼等）单独报价</view>
      <view>· 需外请帮厨、洗碗工时，另计</view>
    </view>

    <view class="gap"></view>
    <view class="gap"></view>
  </view>

  <view class="footer-bar">
    <view class="btn btn-primary" bindtap="goBooking">按这个档位预约</view>
  </view>
</view>
