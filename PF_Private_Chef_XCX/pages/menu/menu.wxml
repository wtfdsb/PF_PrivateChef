<view class="page">
  <view class="wrap">
    <view class="head anim-up d1">
      <view class="h1 serif">三档常做的席</view>
      <view class="muted head-sub">{{chef.area}} · 人数菜量都能调，拿不准就打电话问</view>
    </view>

    <view wx:if="{{loading}}" class="sk-menu">
      <view class="sk" style="height:300rpx;margin-bottom:24rpx;"></view>
      <view class="sk" style="height:360rpx;margin-bottom:24rpx;"></view>
      <view class="sk" style="height:340rpx;"></view>
    </view>

    <view
      wx:for="{{packages}}"
      wx:key="id"
      class="card pkg anim-up"
      style="animation-delay: {{0.15 + index * 0.1}}s"
    >
      <view class="pkg-badge">{{item.tag}}</view>
      <view class="pkg-head">
        <view class="pkg-name serif">{{item.name}}</view>
        <view class="pkg-price">
          <block wx:if="{{item.startPrice > 0}}">
            <text class="pkg-rmb">¥</text><text class="num serif">{{item.startPrice}}</text><text class="pkg-from">起</text>
          </block>
          <block wx:else>
            <text class="num-sm serif">面议·定制</text>
          </block>
        </view>
      </view>

      <view class="pkg-note">{{item.note}}</view>

      <view class="pkg-dishes">
        <text wx:for="{{item.dishes}}" wx:for-item="d" wx:key="*this" class="dish">{{d}}</text>
      </view>

      <view class="pkg-cta" bindtap="goBooking">
        <text wx:if="{{item.startPrice > 0}}">查看详情</text>
        <text wx:else>立即预约</text>
        <text class="pkg-arrow">→</text>
      </view>
    </view>

    <view class="rule">
      <view class="rule-title serif">定金和结算</view>
      <view>· 预约需支付 <text class="em">20% 定金</text>锁定档期，提前 2 天可免费改期</view>
      <view>· 余款<text class="em">餐后结算</text>；定金支持微信/支付宝/现金，线下收取</view>
      <view>· 上表为<text class="em">起步参考价</text>，最终金额以您确认的菜单为准</view>
      <view>· 食材<text class="em">实报实销</text>（提供采购小票），也可由您自行采购</view>
      <view>· 高档食材（参鲍翅肚、深海鱼等）单独报价；需外请帮厨、洗碗工时另计</view>
      <view>· 仅限平顶山市区；偏远区域加收上门里程费</view>
    </view>

    <view class="gap"></view>
    <view class="gap"></view>
  </view>

  <view class="footer-bar">
    <view class="btn btn-primary" bindtap="goBooking">按这个档位预约</view>
  </view>
</view>
