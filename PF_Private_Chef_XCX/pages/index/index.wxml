<view class="page">

  <!-- 加载：骨架屏 -->
  <view wx:if="{{loading}}" class="sk-page">
    <view class="sk sk-hero"></view>
    <view class="wrap">
      <view class="sk sk-title"></view>
      <view class="sk-grid">
        <view class="sk sk-box" wx:for="{{[1,2,3,4]}}" wx:key="*this"></view>
      </view>
      <view class="sk sk-title w40"></view>
      <view class="sk sk-row"></view>
      <view class="sk sk-row"></view>
      <view class="sk sk-title w60"></view>
      <view class="sk sk-card"></view>
      <view class="sk sk-card"></view>
    </view>
  </view>
  <view wx:elif="{{error}}" class="empty">
    <view>{{error}}</view>
    <view class="btn btn-ghost" style="margin:32rpx auto 0;width:300rpx;" bindtap="load">重试</view>
  </view>

  <block wx:else>

    <!-- ========== Hero：品牌 + 数据条 ========== -->
    <view class="hero">
      <view class="hero-top">
        <view class="anim-up d1">
          <view class="hero-brand serif">{{chef.brand}}</view>
          <view class="hero-city">{{chef.city}}</view>
        </view>
        <!-- 厨师头像图片位：images/chef.jpg 就位自动显示，缺失回退印章 -->
        <image
          wx:if="{{!avatarErr}}"
          class="hero-avatar anim-pop d2"
          src="/images/chef.jpg"
          mode="aspectFill"
          binderror="onAvatarError"
        />
        <view wx:else class="hero-mark serif anim-pop d2">宴</view>
      </view>

      <view class="hero-slogan serif anim-up d2">把星级宴席搬进您家</view>
      <view class="hero-sub anim-up d3">平顶山市区，提前一两天约。买菜、掌勺、收拾，都不用您操心。</view>

      <view class="hero-badges anim-up d3">
        <text wx:if="{{chef.awards}}" class="tag-dark">{{chef.awards}}</text>
        <text class="tag-dark">{{chef.title}}</text>
        <text wx:if="{{chef.healthCert}}" class="tag-dark">持健康证</text>
      </view>

      <view class="hero-stats anim-up d4">
        <view class="hero-stat">
          <view class="hero-num serif">{{heroNums.banquets}}<text class="hero-unit">+</text></view>
          <view class="hero-label">场上门家宴</view>
        </view>
        <view class="hero-div"></view>
        <view class="hero-stat">
          <view class="hero-num serif">{{heroNums.cuisines}}<text class="hero-unit">大</text></view>
          <view class="hero-label">菜系精通</view>
        </view>
        <view class="hero-div"></view>
        <view class="hero-stat">
          <view class="hero-num serif">{{heroNums.rating}}<text class="hero-unit">分</text></view>
          <view class="hero-label">客户评分</view>
        </view>
        <view class="hero-div"></view>
        <view class="hero-stat">
          <view class="hero-num serif">{{heroNums.years}}<text class="hero-unit">年</text></view>
          <view class="hero-label">掌勺经验</view>
        </view>
      </view>
    </view>

    <view class="wrap">

      <!-- ========== 服务项目 ========== -->
      <view class="section anim-up d3">
        <view class="section-head">
          <view class="section-title">按场合来选</view>
          <view class="section-more">菜都可以商量</view>
        </view>
        <view class="svc-grid">
          <view
            wx:for="{{services}}"
            wx:key="code"
            class="svc-item anim-pop"
            style="animation-delay: {{0.18 + index * 0.06}}s"
            data-code="{{item.code}}"
            bindtap="goService"
          >
            <view class="svc-name">{{item.name}}</view>
            <view class="svc-desc">{{item.subtitle}}</view>
          </view>
        </view>
      </view>

      <!-- ========== 近期可约档期 ========== -->
      <view class="section anim-up d4">
        <view class="section-head">
          <view class="section-title">最近能约的日子</view>
          <view class="section-more" bindtap="goBooking">看看更多 ›</view>
        </view>
        <scroll-view class="slot-scroll" scroll-x enable-flex>
          <view
            wx:for="{{nextSlots}}"
            wx:key="id"
            class="slot-chip"
            style="animation: fadeIn .4s ease both; animation-delay: {{0.25 + index * 0.05}}s"
            data-date="{{item.date}}"
            data-meal="{{item.meal}}"
            bindtap="goBooking"
          >
            <view class="slot-date">{{item.date}}</view>
            <view class="slot-meal">{{item.meal}} 可约</view>
          </view>
        </scroll-view>
        <view class="dim" style="margin-top:12rpx;">档期有限，点选日期可直接预约；拿不准就打电话问</view>
      </view>

      <!-- ========== 套餐 ========== -->
      <view class="section anim-up d5">
        <view class="section-head">
          <view class="section-title">常点的三档</view>
          <view class="section-more" bindtap="goMenu">看看每档都有啥 ›</view>
        </view>
        <view
          wx:for="{{packages}}"
          wx:key="id"
          class="card pkg-item anim-up"
          style="animation-delay: {{0.3 + index * 0.08}}s"
          data-id="{{item.id}}"
          bindtap="goMenu"
        >
          <view class="pkg-badge">{{item.tag}}</view>
          <view class="pkg-head">
            <view class="pkg-name serif">{{item.name}}</view>
            <view class="pkg-price">
              <block wx:if="{{item.startPrice > 0}}">
                <text class="pkg-rmb">¥</text><text class="pkg-num serif">{{item.startPrice}}</text><text class="pkg-from">起</text>
              </block>
              <block wx:else>
                <text class="pkg-face serif">面议</text>
              </block>
            </view>
          </view>
          <view class="pkg-note">{{item.note}}</view>
          <view class="pkg-chips">
            <text wx:for="{{item.dishes}}" wx:for-item="d" wx:key="*this" class="chip">{{d}}</text>
          </view>
        </view>
        <view class="dim pkg-tip">※ 价格面议：菜单和人数定下来，跟师傅直接谈；食材实报实销</view>
      </view>

      <!-- ========== 最近做的席（图片位：images/case-1.jpg ~ case-6.jpg） ========== -->
      <view class="section anim-up d6">
        <view class="section-head">
          <view class="section-title">最近做的席</view>
          <view class="section-more">点进去看菜单 ›</view>
        </view>
        <scroll-view class="case-scroll" scroll-x enable-flex>
          <view
            wx:for="{{cases}}"
            wx:key="id"
            class="case-item"
            style="animation: fadeUp .5s cubic-bezier(.22,.61,.36,1) both; animation-delay: {{0.32 + index * 0.07}}s"
            data-id="{{item.id}}"
            bindtap="goCase"
          >
            <image
              wx:if="{{item.images.length && !caseImgErr[item.id]}}"
              class="case-ph"
              src="{{item.images[0]}}"
              mode="aspectFill"
              data-id="{{item.id}}"
              binderror="onCaseImgError"
            />
            <view wx:else class="ph case-ph"><text>{{item.scene}}</text></view>
            <view class="case-body">
              <view class="case-title serif">{{item.title}}</view>
              <view class="case-menu">{{item.menu}}</view>
              <view class="case-foot">
                <text class="gold">{{item.people}} 人 · 参考 ¥{{item.refPrice}}</text>
              </view>
            </view>
          </view>
        </scroll-view>
      </view>

      <!-- ========== 定了以后怎么办 ========== -->
      <view class="section anim-up d7">
        <view class="section-head">
          <view class="section-title">定下来以后</view>
        </view>
        <view class="card-ink flow-card">
          <view wx:for="{{chef.flow}}" wx:key="step" class="flow-item">
            <view class="flow-step serif">{{item.step}}</view>
            <view class="flow-body">
              <view class="flow-title">{{item.title}}</view>
              <view class="flow-desc">{{item.desc}}</view>
            </view>
          </view>
        </view>
      </view>

      <!-- ========== 老客户怎么说 ========== -->
      <view class="section anim-up d8" wx:if="{{reviews.length}}">
        <view class="section-head">
          <view class="section-title">老客户怎么说</view>
        </view>
        <view class="card">
          <view wx:for="{{reviews}}" wx:key="id" class="row review-row">
            <view>
              <view class="review-head">
                <text class="h3">{{item.name}}</text>
                <text class="tag">{{item.scene}}</text>
              </view>
              <view class="review-content">{{item.content}}</view>
            </view>
          </view>
        </view>
      </view>

      <!-- ========== 说好的事 ========== -->
      <view class="section anim-up d8">
        <view class="section-head">
          <view class="section-title">说好的事</view>
        </view>
        <view class="card-ink promise-card">
          <view class="promise">
            <view class="promise-name serif">正规食材</view>
            <view class="promise-desc">检疫合格 · 全程可溯</view>
          </view>
          <view class="promise-div"></view>
          <view class="promise">
            <view class="promise-name serif">免费改期</view>
            <view class="promise-desc">提前2天可调整</view>
          </view>
          <view class="promise-div"></view>
          <view class="promise">
            <view class="promise-name serif">餐后清洁</view>
            <view class="promise-desc">厨房简单收拾</view>
          </view>
        </view>
      </view>

      <!-- ========== 底部入口 ========== -->
      <view class="section anim-up d8">
        <view class="card link-card" bindtap="goAbout">
          <text>收费和定金，一条条说清楚</text>
          <text class="dim">›</text>
        </view>
        <view class="card link-card" bindtap="goMy">
          <text>我的预约</text>
          <text class="dim">›</text>
        </view>
      </view>

      <view class="gap"></view>
      <view class="gap"></view>
    </view>

    <!-- ========== 底部固定操作 ========== -->
    <view class="footer-bar footer-2">
      <view class="btn btn-ghost footer-call" bindtap="callChef">电话咨询</view>
      <view class="btn btn-primary footer-main" bindtap="goBooking">立即预约</view>
    </view>

    <!-- ========== 在线客服悬浮按钮（官方客服会话，玻璃拟态胶囊） ========== -->
    <button class="kf-fab kf-pulse" open-type="contact" hover-class="none" bindcontact="onContact">
      <view class="kf-ic kf-icon"></view>
      <text class="kf-tx">客服</text>
    </button>

  </block>
</view>
