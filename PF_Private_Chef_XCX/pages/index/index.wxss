/* ================= Hero：品牌 + 数据条 ================= */
.hero {
  background:
    radial-gradient(320rpx 260rpx at 85% 8%, rgba(201, 161, 94, .18), transparent 65%),
    radial-gradient(400rpx 300rpx at 8% 92%, rgba(201, 161, 94, .08), transparent 70%),
    linear-gradient(165deg, #1c1712 0%, #0f0d0b 40%, #151109 65%, #1c1712 100%);
  background-size: 160% 160%;
  animation: heroGlow 9s ease-in-out infinite;
  padding: 48rpx 32rpx 56rpx;
  border-bottom: 1rpx solid var(--line-ink);
}
.hero-top {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
}
.hero-brand {
  font-size: 56rpx;
  font-weight: 700;
  color: #f5efe2;
  letter-spacing: 8rpx;
  line-height: 1.2;
}
.hero-city {
  color: var(--gold);
  font-size: 24rpx;
  letter-spacing: 4rpx;
  margin-top: 6rpx;
}
/* 厨师头像图片位（images/chef.jpg），缺失时回退到"宴"印章 */
.hero-avatar {
  width: 108rpx;
  height: 108rpx;
  border-radius: 50%;
  border: 3rpx solid rgba(227, 198, 136, .6);
  box-shadow: 0 8rpx 28rpx rgba(0, 0, 0, .35);
  flex-shrink: 0;
}
.hero-mark {
  width: 92rpx;
  height: 92rpx;
  line-height: 92rpx;
  text-align: center;
  font-size: 48rpx;
  color: #241d16;
  background: linear-gradient(135deg, var(--gold-2), var(--gold));
  border-radius: 18rpx;
  transform: rotate(6deg);
}
.hero-slogan {
  color: #f5efe2;
  font-size: 40rpx;
  font-weight: 600;
  letter-spacing: 4rpx;
  margin-top: 36rpx;
}
.hero-sub {
  color: rgba(245, 239, 226, .6);
  font-size: 25rpx;
  margin-top: 14rpx;
  letter-spacing: 1rpx;
}
.hero-badges { margin-top: 28rpx; }
.hero-badges .tag-dark { margin-bottom: 10rpx; }

.hero-stats {
  display: flex;
  align-items: center;
  margin-top: 40rpx;
  padding-top: 34rpx;
  border-top: 1rpx solid rgba(201, 161, 94, .18);
}
.hero-stat { flex: 1; text-align: center; }
.hero-div {
  width: 1rpx;
  height: 60rpx;
  background: rgba(201, 161, 94, .22);
}
.hero-num {
  color: var(--gold-2);
  font-size: 44rpx;
  font-weight: 700;
  line-height: 1.2;
}
.hero-unit { font-size: 22rpx; margin-left: 2rpx; font-weight: 400; }
.hero-label {
  color: rgba(245, 239, 226, .5);
  font-size: 22rpx;
  margin-top: 4rpx;
  letter-spacing: 1rpx;
}

/* ================= 服务项目网格 ================= */
.svc-grid {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 16rpx;
}
.svc-item {
  background: var(--paper-2);
  border: 1rpx solid var(--line);
  border-radius: 16rpx;
  padding: 24rpx 26rpx;
  position: relative;
}
.svc-item:active { border-color: var(--gold); }
.svc-name {
  font-size: 29rpx;
  font-weight: 600;
  letter-spacing: 1rpx;
}
.svc-desc {
  color: var(--text-3);
  font-size: 22rpx;
  margin-top: 6rpx;
}

/* ================= 档期横向滚动 ================= */
.slot-scroll {
  white-space: nowrap;
  width: 100%;
}
.slot-chip {
  display: inline-block;
  min-width: 176rpx;
  padding: 20rpx 24rpx;
  margin-right: 16rpx;
  border-radius: 16rpx;
  background: var(--paper-2);
  border: 1rpx solid var(--line);
  text-align: center;
}
.slot-chip:active { border-color: var(--gold); }
.slot-date {
  font-size: 26rpx;
  font-weight: 600;
  color: var(--text);
}
.slot-meal {
  font-size: 22rpx;
  color: #9a7a35;
  margin-top: 6rpx;
}

/* ================= 套餐卡 ================= */
.pkg-item {
  padding: 28rpx;
  margin-bottom: 20rpx;
  position: relative;
}
.pkg-badge {
  position: absolute;
  top: 0;
  right: 0;
  font-size: 20rpx;
  letter-spacing: 2rpx;
  color: #241d16;
  background: linear-gradient(135deg, var(--gold-2), var(--gold));
  padding: 6rpx 22rpx;
  border-radius: 0 20rpx 0 16rpx;
}
.pkg-head {
  display: flex;
  align-items: flex-end;
  justify-content: space-between;
  padding-right: 120rpx;
}
.pkg-name {
  font-size: 34rpx;
  font-weight: 600;
  letter-spacing: 2rpx;
}
.pkg-price { text-align: right; flex-shrink: 0; }
.pkg-rmb { font-size: 24rpx; color: var(--gold); }
.pkg-num { font-size: 52rpx; font-weight: 700; color: #9a7a35; }
.pkg-from { font-size: 22rpx; color: var(--text-3); margin-left: 4rpx; }
.pkg-face { font-size: 30rpx; font-weight: 700; color: #9a7a35; }
.pkg-note {
  color: var(--text-2);
  font-size: 24rpx;
  line-height: 1.75;
  margin-top: 12rpx;
}
.pkg-chips { margin-top: 18rpx; }
.chip {
  display: inline-block;
  padding: 6rpx 20rpx;
  border-radius: 999rpx;
  font-size: 22rpx;
  background: rgba(201, 161, 94, .1);
  border: 1rpx solid rgba(201, 161, 94, .3);
  color: #9a7a35;
  margin: 0 12rpx 10rpx 0;
}
.pkg-tip {
  margin-top: 12rpx;
  line-height: 1.7;
}

/* ================= 案例横滑 ================= */
.case-scroll {
  white-space: nowrap;
  width: 100%;
}
.case-item {
  display: inline-block;
  width: 460rpx;
  margin-right: 20rpx;
  background: var(--paper-2);
  border: 1rpx solid var(--line);
  border-radius: 20rpx;
  overflow: hidden;
  vertical-align: top;
}
.case-item:active { border-color: var(--gold); }
.case-ph { height: 240rpx; width: 100%; }
.case-body { padding: 22rpx 24rpx 24rpx; }
.case-title {
  font-size: 29rpx;
  font-weight: 600;
  letter-spacing: 1rpx;
  white-space: normal;
}
.case-menu {
  color: var(--text-2);
  font-size: 23rpx;
  line-height: 1.7;
  margin-top: 10rpx;
  white-space: normal;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
  overflow: hidden;
}
.case-foot {
  margin-top: 14rpx;
  padding-top: 14rpx;
  border-top: 1rpx solid var(--line);
  font-size: 23rpx;
}

/* ================= 服务流程 ================= */
.flow-card { padding: 8rpx 28rpx; border-radius: 20rpx; }
.flow-item {
  display: flex;
  align-items: flex-start;
  padding: 26rpx 0;
  border-bottom: 1rpx solid rgba(201, 161, 94, .12);
}
.flow-item:last-child { border-bottom: none; }
.flow-step {
  width: 68rpx;
  height: 68rpx;
  line-height: 68rpx;
  text-align: center;
  border-radius: 50%;
  background: rgba(201, 161, 94, .14);
  color: var(--gold-2);
  font-size: 26rpx;
  font-weight: 700;
  margin-right: 24rpx;
  flex-shrink: 0;
}
.flow-body { flex: 1; }
.flow-title { color: #f0e8d8; font-size: 28rpx; font-weight: 600; }
.flow-desc { color: rgba(240, 232, 216, .55); font-size: 24rpx; margin-top: 4rpx; }

/* ================= 评价 ================= */
.review-row { display: block; padding: 26rpx 28rpx; }
.review-head { display: flex; align-items: center; gap: 12rpx; }
.review-content {
  color: var(--text-2);
  font-size: 26rpx;
  line-height: 1.75;
  margin-top: 12rpx;
}

/* ================= 服务承诺 ================= */
.promise-card {
  display: flex;
  align-items: center;
  padding: 30rpx 12rpx;
  border-radius: 20rpx;
}
.promise { flex: 1; text-align: center; }
.promise-div {
  width: 1rpx;
  height: 60rpx;
  background: rgba(201, 161, 94, .2);
}
.promise-name {
  color: var(--gold-2);
  font-size: 28rpx;
  font-weight: 600;
  letter-spacing: 2rpx;
}
.promise-desc {
  color: rgba(240, 232, 216, .5);
  font-size: 21rpx;
  margin-top: 6rpx;
}

/* ================= 底部链接卡 ================= */
.link-card {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 30rpx 28rpx;
  margin-bottom: 16rpx;
}

/* ================= 底部操作条 ================= */
.footer-2 { display: flex; gap: 20rpx; }
.footer-call { width: 240rpx; flex-shrink: 0; }
.footer-main { flex: 1; }

/* ================= 在线客服悬浮按钮（玻璃拟态胶囊） ================= */
.kf-fab {
  position: fixed;
  right: 28rpx;
  bottom: 208rpx;
  height: 80rpx;
  padding: 0 30rpx 0 20rpx;
  margin: 0;
  border-radius: 999rpx;
  background: rgba(15, 13, 11, .92);
  border: 1rpx solid rgba(227, 198, 136, .45);
  box-shadow: 0 12rpx 36rpx rgba(0, 0, 0, .4);
  backdrop-filter: blur(12rpx);
  display: flex;
  align-items: center;
  z-index: 50;
  animation: popIn .5s .9s cubic-bezier(.34, 1.56, .64, 1) both;
  transition: transform .15s ease, opacity .15s ease;
}
.kf-fab:active { transform: scale(.94); opacity: .9; }
.kf-fab::after { border: none; }
.kf-ic {
  width: 40rpx;
  height: 40rpx;
  margin-right: 10rpx;
  flex-shrink: 0;
}
.kf-tx {
  color: var(--gold-2);
  font-size: 24rpx;
  font-weight: 600;
  letter-spacing: 2rpx;
  line-height: 1;
}
/* 悬浮呼吸（叠加在 .kf-fab 的 animation 之后） */
.kf-fab.kf-pulse { animation: popIn .5s .9s cubic-bezier(.34, 1.56, .64, 1) both, ripple 2.6s 1.5s ease-out infinite; }
