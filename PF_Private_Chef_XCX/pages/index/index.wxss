/* ================= Hero 厨师名片 ================= */
.hero {
  background: linear-gradient(160deg, #241d16 0%, #14100c 60%, #1c1610 100%);
  padding: 56rpx 32rpx 64rpx;
  border-bottom: 1rpx solid rgba(200, 164, 92, .25);
}
.hero-inner { position: relative; }
.hero-badge {
  display: inline-block;
  font-size: 22rpx;
  color: var(--gold-2);
  border: 1rpx solid rgba(200, 164, 92, .4);
  border-radius: 999rpx;
  padding: 6rpx 20rpx;
  margin-bottom: 24rpx;
}
.hero-badge-dot { margin: 0 10rpx; opacity: .6; }
.hero-name {
  font-size: 58rpx;
  font-weight: 700;
  color: #fbf7f0;
  letter-spacing: 4rpx;
  line-height: 1.2;
}
.hero-title {
  color: var(--gold);
  font-size: 28rpx;
  margin-top: 8rpx;
  letter-spacing: 2rpx;
}
.hero-area {
  color: rgba(251, 247, 240, .62);
  font-size: 24rpx;
  margin-top: 16rpx;
}
.hero-tags { margin-top: 24rpx; }
.hero-intro {
  color: rgba(251, 247, 240, .78);
  font-size: 26rpx;
  line-height: 1.75;
  margin-top: 24rpx;
}
.hero-stats {
  display: flex;
  align-items: center;
  margin-top: 40rpx;
  padding-top: 32rpx;
  border-top: 1rpx solid rgba(200, 164, 92, .2);
}
.hero-stat { flex: 1; text-align: center; }
.hero-stat-div {
  width: 1rpx;
  height: 56rpx;
  background: rgba(200, 164, 92, .25);
}
.hero-stat-num {
  color: var(--gold-2);
  font-size: 42rpx;
  font-weight: 700;
  line-height: 1.2;
}
.hero-stat-unit {
  font-size: 22rpx;
  margin-left: 4rpx;
  font-weight: 400;
}
.hero-stat-label {
  color: rgba(251, 247, 240, .55);
  font-size: 22rpx;
  margin-top: 6rpx;
}

/* ================= 档期横向滚动 ================= */
.slot-scroll {
  white-space: nowrap;
  width: 100%;
}
.slot-chip {
  display: inline-block;
  min-width: 168rpx;
  padding: 20rpx 24rpx;
  margin-right: 16rpx;
  border-radius: 16rpx;
  background: var(--paper-2);
  border: 1rpx solid var(--line);
  text-align: center;
}
.slot-chip:active { border-color: var(--gold); }
.slot-date {
  font-size: 26rpx;
  font-weight: 600;
  color: var(--text);
}
.slot-meal {
  font-size: 22rpx;
  color: #9a7a35;
  margin-top: 6rpx;
}

/* ================= 服务流程 ================= */
.flow-card { padding: 8rpx 28rpx; }
.flow-item {
  display: flex;
  align-items: flex-start;
  padding: 26rpx 0;
  border-bottom: 1rpx solid var(--line);
}
.flow-item:last-child { border-bottom: none; }
.flow-step {
  width: 68rpx;
  height: 68rpx;
  line-height: 68rpx;
  text-align: center;
  border-radius: 50%;
  background: rgba(200, 164, 92, .14);
  color: #9a7a35;
  font-size: 26rpx;
  font-weight: 700;
  margin-right: 24rpx;
  flex-shrink: 0;
}
.flow-body { flex: 1; }

/* ================= 作品案例卡 ================= */
.case-card { margin-bottom: 24rpx; }
.case-ph { height: 260rpx; }
.case-body { padding: 24rpx 28rpx 26rpx; }
.case-top {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 12rpx;
}
.case-title { margin-bottom: 10rpx; }
.case-menu {
  color: var(--text-2);
  font-size: 25rpx;
  line-height: 1.7;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
  overflow: hidden;
}
.case-foot {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-top: 20rpx;
  padding-top: 20rpx;
  border-top: 1rpx solid var(--line);
}
.case-price { font-size: 30rpx; font-weight: 700; }

/* ================= 参考套餐 ================= */
.pkg-list { display: block; }
.pkg-item { padding: 26rpx 28rpx; margin-bottom: 20rpx; }
.pkg-head {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
}
.pkg-price { text-align: right; flex-shrink: 0; margin-left: 20rpx; }
.pkg-num { font-size: 44rpx; font-weight: 700; }
.pkg-num-sm { font-size: 34rpx; font-weight: 700; }
.pkg-dishes {
  color: var(--text-2);
  font-size: 25rpx;
  line-height: 1.8;
  margin-top: 16rpx;
}
.pkg-note {
  margin-top: 10rpx;
  padding-top: 14rpx;
  border-top: 1rpx dashed var(--line);
}
.pkg-tip {
  margin-top: 12rpx;
  line-height: 1.7;
}

/* ================= 评价 ================= */
.review-row { display: block; padding: 26rpx 28rpx; }
.review-head { display: flex; align-items: center; gap: 12rpx; }
.review-content {
  color: var(--text-2);
  font-size: 26rpx;
  line-height: 1.75;
  margin-top: 12rpx;
}

/* ================= 底部链接卡 ================= */
.link-card {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 30rpx 28rpx;
  margin-bottom: 16rpx;
}

/* ================= 底部操作条 ================= */
.footer-2 { display: flex; gap: 20rpx; }
.footer-call { width: 240rpx; flex-shrink: 0; }
.footer-main { flex: 1; }
