<view class="page">
  <view class="wrap">
    <view wx:if="{{loading}}" class="empty">正在加载…</view>

    <block wx:elif="{{list.length}}">
      <view wx:for="{{list}}" wx:key="id" class="card bk">
        <view class="bk-head">
          <view class="h3">{{item.date}} · {{item.meal}}</view>
          <view class="status">{{statusText[item.status] || item.status}}</view>
        </view>
        <view class="bk-line">{{item.people}} 人 · 预算 ¥{{item.budget}}</view>
        <view class="bk-line bk-addr">{{item.address}}</view>
        <view class="bk-line dim" wx:if="{{item.remark}}">备注：{{item.remark}}</view>
      </view>
    </block>

    <view wx:else class="empty-wrap">
      <view class="empty">还没有预约记录</view>
      <view class="btn btn-primary" style="margin:0 auto;width:360rpx;" bindtap="goBooking">去预约</view>
    </view>

    <view class="gap"></view>
  </view>
</view>
