.bk { padding: 28rpx; margin-top: 24rpx; }
.bk-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 14rpx;
}
.bk-title {
  font-size: 31rpx;
  font-weight: 600;
  letter-spacing: 1rpx;
}
.status {
  font-size: 23rpx;
  padding: 4rpx 16rpx;
  border-radius: 999rpx;
  border: 1rpx solid;
}
.st-pending { color: #b07c2e; border-color: rgba(176, 124, 46, .5); background: rgba(201, 161, 94, .08); }
.st-confirmed { color: #9a7a35; border-color: rgba(154, 122, 53, .5); background: rgba(201, 161, 94, .12); }
.st-making { color: #4a7f9e; border-color: rgba(74, 127, 158, .5); background: rgba(74, 127, 158, .08); }
.st-done { color: var(--ok); border-color: rgba(47, 143, 91, .5); background: rgba(47, 143, 91, .08); }
.st-canceled { color: var(--text-3); border-color: var(--line); background: rgba(0, 0, 0, .02); }

.bk-line { font-size: 27rpx; line-height: 1.85; color: var(--text-2); }
.bk-addr { word-break: break-all; }
.bk-no {
  margin-top: 10rpx;
  font-size: 22rpx;
  color: var(--text-3);
  font-family: monospace;
}

/* 进度时间线 */
.steps {
  display: flex;
  align-items: flex-start;
  padding: 18rpx 0 22rpx;
  border-bottom: 1rpx dashed var(--line);
  margin-bottom: 18rpx;
}
.step {
  flex: 1;
  text-align: center;
  position: relative;
}
.step::before {
  content: '';
  position: absolute;
  top: 9rpx;
  left: -50%;
  right: 50%;
  height: 2rpx;
  background: var(--line);
}
.step:first-child::before { display: none; }
.step.st-done::before { background: var(--gold); }
.step-dot {
  width: 20rpx;
  height: 20rpx;
  border-radius: 50%;
  margin: 0 auto 8rpx;
  background: var(--paper-2);
  border: 2rpx solid var(--line);
  position: relative;
  z-index: 1;
  transition: all .3s ease;
}
.step-name {
  font-size: 20rpx;
  color: var(--text-3);
  letter-spacing: 1rpx;
}
.step-dot.on {
  background: linear-gradient(135deg, var(--gold-2), var(--gold));
  border-color: var(--gold);
  box-shadow: 0 0 0 8rpx rgba(201, 161, 94, .12);
}
.step-name.on { color: #9a7a35; font-weight: 600; }
.step-dot.done { background: var(--gold); border-color: var(--gold); }
.step-name.done { color: var(--text-2); }
.step-dot.skip { opacity: .35; }
.step-name.skip { opacity: .4; }

.bk-canceled {
  padding: 14rpx 0;
  margin-bottom: 14rpx;
  border-bottom: 1rpx dashed var(--line);
  font-size: 24rpx;
  color: var(--text-3);
}

.bk-dep {
  margin-top: 16rpx;
  padding: 14rpx 20rpx;
  border-radius: 12rpx;
  font-size: 24rpx;
  background: rgba(201, 161, 94, .07);
  border: 1rpx dashed rgba(201, 161, 94, .35);
  color: #9a7a35;
}

.bk-actions {
  display: flex;
  gap: 16rpx;
  margin-top: 22rpx;
}
.bk-btn {
  flex: 1;
  text-align: center;
  padding: 16rpx 0;
  border-radius: 12rpx;
  font-size: 26rpx;
  border: 1rpx solid var(--line);
  color: var(--text-2);
}
.bk-btn-call {
  background: linear-gradient(135deg, var(--gold-2), var(--gold));
  color: #241d16;
  border: none;
  font-weight: 600;
}
.bk-btn:active { opacity: .85; }

.empty-wrap { padding-top: 40rpx; }
