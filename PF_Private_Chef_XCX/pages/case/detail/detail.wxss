.cover { height: 420rpx; }
.cover-swiper { height: 460rpx; }
.cover-img { width: 100%; height: 100%; }

.head { padding: 36rpx 0 24rpx; }
.tags { margin-bottom: 16rpx; }
.title { letter-spacing: 2rpx; line-height: 1.35; }

.block { padding: 28rpx; margin-bottom: 24rpx; }
.block-title {
  font-family: "Songti SC", "Noto Serif SC", Georgia, serif;
  font-size: 27rpx;
  color: #9a7a35;
  letter-spacing: 3rpx;
  margin-bottom: 14rpx;
}
.menu-text { font-size: 28rpx; line-height: 1.9; }
.hl-text { font-size: 27rpx; line-height: 1.9; color: var(--text-2); }

.price-block {
  display: flex;
  align-items: center;
  justify-content: space-between;
}
.price { font-size: 52rpx; font-weight: 700; line-height: 1.2; }
.price-note { text-align: right; line-height: 1.7; }

/* 在线客服行 */
.kf-row {
  width: 100%;
  margin: 8rpx 0 0;
  padding: 26rpx 28rpx;
  border-radius: 16rpx;
  background: rgba(201, 161, 94, .07);
  border: 1rpx solid rgba(201, 161, 94, .3);
  color: #9a7a35;
  font-size: 26rpx;
  text-align: left;
  letter-spacing: 1rpx;
  line-height: 1.6;
  transition: transform .15s ease;
}
.kf-row::after { border: none; }
.kf-row:active { transform: scale(.98); }
