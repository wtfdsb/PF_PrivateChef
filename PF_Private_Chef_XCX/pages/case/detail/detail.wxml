<view class="page">
  <view wx:if="{{loading}}" class="empty">正在加载…</view>
  <view wx:elif="{{error}}" class="empty">{{error}}</view>

  <block wx:else>
    <!-- 图片位：案例图就位显示轮播，缺失回退渐变占位 -->
    <swiper
      wx:if="{{item.images.length && !coverErr}}"
      class="cover-swiper"
      indicator-dots="{{item.images.length > 1}}"
      indicator-color="rgba(255,255,255,.35)"
      indicator-active-color="#e3c688"
      circular
    >
      <swiper-item wx:for="{{item.images}}" wx:key="*this">
        <image class="cover-img" src="{{item}}" mode="aspectFill" binderror="onCoverError" />
      </swiper-item>
    </swiper>
    <view wx:else class="ph cover anim-in"><text>{{item.scene}}</text></view>

    <view class="wrap">
      <view class="head anim-up d1">
        <view class="tags">
          <text class="tag">{{item.scene}}</text>
          <text class="tag">{{item.people}} 人</text>
          <text class="tag">{{item.date}}</text>
        </view>
        <view class="h1 serif title">{{item.title}}</view>
      </view>

      <view class="card block anim-up d2">
        <view class="block-title">菜单</view>
        <view class="menu-text">{{item.menu}}</view>
      </view>

      <view class="card block anim-up d3">
        <view class="block-title">这一桌的关键</view>
        <view class="hl-text">{{item.highlight}}</view>
      </view>

      <view class="card block price-block anim-up d4">
        <view>
          <view class="dim">这一桌的花费（参考）</view>
          <view class="gold price serif">¥{{item.refPrice}}</view>
        </view>
        <view class="dim price-note">食材实报实销\n最终以确认菜单为准</view>
      </view>

      <view class="anim-up d5">
        <button class="kf-row" open-type="contact" hover-class="none">
          <view class="kf-ic kf-icon"></view>
          <text>想要差不多的？跟师傅聊聊 ›</text>
        </button>
      </view>

      <view class="gap"></view>
      <view class="gap"></view>
    </view>

    <view class="footer-bar anim-up d6">
      <view class="btn btn-primary" bindtap="goBooking">预约一桌这样的席面</view>
    </view>
  </block>
</view>
