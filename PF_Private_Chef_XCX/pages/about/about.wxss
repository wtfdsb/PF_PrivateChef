.head { padding: 44rpx 0 32rpx; }
.head-sub { margin-top: 12rpx; }

/* 服务承诺 */
.promises {
  display: flex;
  background: var(--ink-2);
  border: 1rpx solid var(--line-ink);
  border-radius: 20rpx;
  padding: 28rpx 8rpx;
  margin-bottom: 24rpx;
}
.promise-item { flex: 1; text-align: center; }
.promise-name {
  color: var(--gold-2);
  font-size: 28rpx;
  font-weight: 600;
  letter-spacing: 2rpx;
}
.promise-desc {
  color: rgba(240, 232, 216, .5);
  font-size: 21rpx;
  margin-top: 6rpx;
}

.block { padding: 28rpx; margin-bottom: 24rpx; }
.block-title {
  font-family: "Songti SC", "Noto Serif SC", Georgia, serif;
  font-size: 27rpx;
  color: #9a7a35;
  letter-spacing: 3rpx;
  margin-bottom: 16rpx;
}
.line { font-size: 27rpx; line-height: 1.95; color: var(--text-2); }
.em { color: #9a7a35; }

.flow {
  display: flex;
  align-items: flex-start;
  padding: 16rpx 0;
}
.flow-step {
  width: 60rpx;
  height: 60rpx;
  line-height: 60rpx;
  text-align: center;
  border-radius: 50%;
  background: rgba(201, 161, 94, .14);
  color: #9a7a35;
  font-size: 24rpx;
  font-weight: 700;
  margin-right: 22rpx;
  flex-shrink: 0;
}

.contact {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 30rpx 28rpx;
  background: var(--paper-2);
  border: 1rpx solid var(--line);
  border-radius: 20rpx;
}
